# ==============================================================================
# Vault Storage Backend Environment Configuration
# Copy this file to .env before starting the server or deploying:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Base URL where this backend API is running (used for OAuth redirects & callbacks)
BACKEND_URL=http://localhost:4000
# Frontend client URL (used for CORS whitelist and cookie domain validation)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database & Cache Configuration
# ------------------------------------------------------------------------------
# MongoDB Connection String (IMPORTANT: Replica Set required for multi-document ACID transactions, e.g. replicaSet=rs0 or MongoDB Atlas URI)
DB_URL=mongodb://localhost:27017/vault_storage?replicaSet=rs0

# Redis Connection URL (Used for distributed session sets, cache-aside trees, and rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 3. Security & Session Secrets
# ------------------------------------------------------------------------------
# High-entropy secret string used for signing session cookies (minimum 32 characters recommended)
SESSION_SECRET=your_super_secret_session_signing_key_change_in_production

# Max concurrent active devices per user account
MAX_DEVICES_LIMIT=3

# Max upload file size limit in bytes (e.g. 104857600 = 100MB)
MAX_FILE_SIZE=104857600

# ------------------------------------------------------------------------------
# 4. Object Storage (Backblaze B2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
# Backblaze B2 S3-Compatible Endpoint (e.g., https://s3.ca-east-006.backblazeb2.com or https://s3.us-east-005.backblazeb2.com)
BACKBLAZE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_REGION=us-east-005
BACKBLAZE_ACCESS_KEY_ID=your_b2_application_key_id
BACKBLAZE_SECRET_ACCESS_KEY=your_b2_application_key
BACKBLAZE_BUCKET_NAME=your_vault_storage_bucket_name

# ------------------------------------------------------------------------------
# 5. Cloudflare Edge CDN & Bandwidth Alliance
# ------------------------------------------------------------------------------
# Public custom domain routed through Cloudflare Worker
CLOUDFLARE_CDN_DOMAIN=https://cdn.yourdomain.com
# Shared HMAC-SHA256 secret key for signing media stream URLs (shared with Cloudflare Worker)
CLOUDFLARE_CDN_SECRET=your_64_character_hex_hmac_secret_key

# ------------------------------------------------------------------------------
# 6. OAuth Providers (Google & GitHub)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App Credentials (from GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 7. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API Keys (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret for validating incoming webhook signatures
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 8. Firebase Phone Verification (SMS 2FA)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id

# ------------------------------------------------------------------------------
# 9. Email Service (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
