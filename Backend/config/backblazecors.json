{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://yourvaultstorage.com",
        "https://www.yourvaultstorage.com",
        "http://yourvaultstorage.com",
        "http://www.yourvaultstorage.com",
        "http://localhost:5173",
        "http://localhost:4000"
      ],
      "AllowedMethods": ["GET", "HEAD", "PUT", "DELETE", "POST"],
      "AllowedHeaders": ["*"],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Accept-Ranges",
        "Content-Range"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
